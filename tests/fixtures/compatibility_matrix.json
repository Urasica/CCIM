          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "read-1",
              "content": "def calculate_total(values):\n    subtotal = 0\n    for value in values:\n        normalized = int(value)\n        if normalized < 0:\n            raise ValueError(\"negative\")\n        subtotal += normalized\n    tax = subtotal * 0.1\n    result = subtotal + tax\n    audit = {\"subtotal\": subtotal, \"tax\": tax}\n    if audit[\"subtotal\"] != subtotal:\n        raise AssertionError(\"audit\")\n    rounded = round(result, 2)\n    if rounded < subtotal:\n        raise AssertionError(\"rounding\")\n    result = rounded\n    marker = \"complete\"\n    if marker != \"complete\":\n        raise AssertionError(\"marker\")\n    return result\n"
            }
          ]
        }
      ]
    },
