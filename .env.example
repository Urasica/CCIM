# CCIM Gateway environment example
# Copy this file to .env and fill provider credentials.

# LLM provider
CCIM_LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
CCIM_LLM_MODEL=gpt-5-mini
CCIM_LLM_TIMEOUT_S=300

# Anthropic example
# CCIM_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-me
# CCIM_LLM_MODEL=claude-sonnet-4-6

# OpenAI-compatible local endpoint example
# CCIM_LLM_PROVIDER=openai-compatible
# CCIM_LLM_BASE_URL=http://localhost:11434
# CCIM_LLM_MODEL=gemma-basic
# OPENAI_API_KEY=ollama

# Infrastructure
CCIM_REDIS_URL=redis://localhost:6379/0
CCIM_DATABASE_URL=postgresql+asyncpg://ccim:ccim@localhost:5432/ccim

# Optional PCFI / Llama Guard
# CCIM_LLAMAGUARD_URL=http://localhost:11434
# CCIM_LLAMAGUARD_MODEL=llama-guard3:8b-q4_K_M

# Optional OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Compression / Admin-managed settings
CCIM_SESSION_PREFIX=
CCIM_COMPRESSION_ENABLED=true
CCIM_COMPRESSION_TRIGGER_TOKENS=20000
CCIM_COMPRESSION_TARGET_TOKENS=14000
CCIM_COMPRESSION_ENABLE_RETRIEVE=false
CCIM_CURRENT_TURN_COMPRESSION_ENABLED=false
CCIM_CURRENT_TURN_COMPRESSION_TRIGGER_TOKENS=20000
CCIM_CURRENT_TURN_COMPRESSION_READ_TOOLS=Read,Grep,Glob,LS,Search
CCIM_COMPRESSION_CLUSTER_SUMMARY_ENABLED=false
CCIM_COMPRESSION_WRITE_GUARD_ENABLED=true
CCIM_COMPRESSION_WRITE_GUARD_TOOLS=Edit,MultiEdit,Write

# Optional admin UI token. If empty, localhost binding is the only guard.
# CCIM_ADMIN_TOKEN=

# Optional uv executable override when uv is not on PATH.
# CCIM_UV_EXE=C:\Path\To\uv.exe
